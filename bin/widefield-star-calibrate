#!/usr/bin/env sh
set -eu

script=$0
while [ -L "$script" ]; do
    dir=$(CDPATH= cd -- "$(dirname -- "$script")" && pwd)
    link=$(readlink "$script")
    case "$link" in
        /*) script=$link ;;
        *) script=$dir/$link ;;
    esac
done

bin_dir=$(CDPATH= cd -- "$(dirname -- "$script")" && pwd)
repo_root=$(CDPATH= cd -- "$bin_dir/.." && pwd)

exec node "$repo_root/tools/run_lucky_report.js" "$@"
